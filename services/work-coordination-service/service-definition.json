{
  "service_id": "work-coordination-service",
  "display_name": "LEOS Work Coordination Service",
  "version": "0.2.0-dev-preview-v2",
  "service_contract": "leos.work-coordination-service.provisional-v1",
  "authority": "work-coordination-service",
  "port": 8118,
  "health_endpoint": "/health",
  "readiness_endpoint": "/ready",
  "description": "Canonical Dev Preview v2 owner for Work Requests, Workflow Definitions/Revisions, Tasks, Dependencies, assignment decisions, same-Organization Delegation, Work Results, verification, closure, retry intents, escalation intents, and producer-local outbox records.",
  "dependencies": [
    "organization-domain-service",
    "employee-registry",
    "execution-scheduler-service",
    "persistent-employee-runtime-service",
    "authorization-authority"
  ],
  "authorization_verification": {
    "authority": "authorization-authority",
    "endpoint": "/authorization-decisions/{decision_id}/verify",
    "required_for": [
      "authority-bearing Work Coordination mutations",
      "assignment decision creation",
      "scheduler projection request records",
      "runtime handoff request records",
      "verification and closure records"
    ],
    "fail_closed": true
  },
  "authority_boundaries": {
    "does_not_own": [
      "scheduler_jobs",
      "scheduler_leases",
      "runtime_assignment_projection",
      "employee_lifecycle",
      "organization_lifecycle",
      "authorization_decisions",
      "approval_grants",
      "capability_resolution",
      "dispatcher_invocation",
      "secret_values",
      "event_delivery"
    ]
  }
}
