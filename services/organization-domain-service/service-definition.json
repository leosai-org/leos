{
  "service_id": "organization-domain-service",
  "name": "Organization Domain Service",
  "version": "0.2.0-dev-preview-v2",
  "service_contract": "leos.organization-domain-service.provisional-v1",
  "authority": "Organization Domain Service",
  "capabilities": [
    "organizations.lifecycle",
    "organizations.relationships",
    "organizations.audit",
    "organizations.outbox"
  ],
  "dependencies": [
    "identity-authority",
    "authorization-authority",
    "approval-authority",
    "employee-registry",
    "event-delivery-service"
  ],
  "authorization_verification": {
    "authority": "authorization-authority",
    "endpoint": "/authorization-decisions/{decision_id}/verify",
    "required_for": [
      "organization-domain create",
      "organization-domain update",
      "organization-domain lifecycle transition"
    ],
    "fail_closed": true
  },
  "persistence": {
    "type": "sqlite",
    "path": "/data/organization-domain/organization-domain.db",
    "outbox": "local-producer-outbox"
  }
}
