{
  "$id": "https://leosai.org/contracts/actor-context.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LEOS Actor Context v1",
  "description": "Authenticated actor evidence issued by a trusted authentication boundary. Structural validity alone never authenticates the actor.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "leos.actor-context.v1"
    },
    "identity": {
      "$ref": "https://leosai.org/contracts/trust-common.v1.schema.json#/$defs/managedIdentity"
    },
    "actor": {
      "$ref": "https://leosai.org/contracts/trust-common.v1.schema.json#/$defs/principalRef"
    },
    "authentication": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "authentication_id": {
          "$ref": "https://leosai.org/contracts/trust-common.v1.schema.json#/$defs/identifier"
        },
        "subject": {
          "$ref": "https://leosai.org/contracts/trust-common.v1.schema.json#/$defs/principalRef"
        },
        "issuer": {
          "$ref": "https://leosai.org/contracts/trust-common.v1.schema.json#/$defs/authorityRef"
        },
        "method": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "assurance": {
          "enum": [
            "DEVELOPMENT",
            "LOCAL_VERIFIED",
            "MULTI_FACTOR",
            "WORKLOAD_VERIFIED"
          ]
        },
        "authenticated_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "authentication_id",
        "subject",
        "issuer",
        "method",
        "assurance",
        "authenticated_at"
      ]
    },
    "initiator": {
      "$ref": "https://leosai.org/contracts/trust-common.v1.schema.json#/$defs/principalRef"
    },
    "delegation_ref": {
      "$ref": "https://leosai.org/contracts/trust-common.v1.schema.json#/$defs/evidenceRef"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "contract_version",
    "identity",
    "actor",
    "authentication",
    "issued_at",
    "expires_at"
  ],
  "dependentRequired": {
    "initiator": [
      "delegation_ref"
    ],
    "delegation_ref": [
      "initiator"
    ]
  }
}
