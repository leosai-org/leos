{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leosai.org/contracts/work-common.v1.schema.json",
  "title": "LEOS Work Domain Common Definitions v1",
  "$defs": {
    "typedRefBase": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "resource_type": {"type": "string"},
        "resource_id": {"$ref": "https://leosai.org/contracts/trust-common.v1.schema.json#/$defs/identifier"},
        "revision": {"$ref": "https://leosai.org/contracts/trust-common.v1.schema.json#/$defs/revision"}
      },
      "required": ["resource_type", "resource_id", "revision"]
    },
    "workRequestRef": {
      "allOf": [
        {"$ref": "#/$defs/typedRefBase"},
        {"properties": {"resource_type": {"const": "WORK_REQUEST"}}}
      ]
    },
    "workflowDefinitionRef": {
      "allOf": [
        {"$ref": "#/$defs/typedRefBase"},
        {"properties": {"resource_type": {"const": "WORKFLOW_DEFINITION"}}}
      ]
    },
    "workflowRevisionRef": {
      "allOf": [
        {"$ref": "#/$defs/typedRefBase"},
        {"properties": {"resource_type": {"const": "WORKFLOW_REVISION"}}}
      ]
    },
    "jobRef": {
      "allOf": [
        {"$ref": "#/$defs/typedRefBase"},
        {"properties": {"resource_type": {"const": "SCHEDULER_JOB"}}}
      ]
    },
    "taskRef": {
      "allOf": [
        {"$ref": "#/$defs/typedRefBase"},
        {"properties": {"resource_type": {"const": "TASK"}}}
      ]
    },
    "workRef": {
      "oneOf": [
        {"$ref": "#/$defs/jobRef"},
        {"$ref": "#/$defs/taskRef"}
      ]
    },
    "assignmentRef": {
      "allOf": [
        {"$ref": "#/$defs/typedRefBase"},
        {"properties": {"resource_type": {"const": "WORK_ASSIGNMENT"}}}
      ]
    },
    "delegationRef": {
      "allOf": [
        {"$ref": "#/$defs/typedRefBase"},
        {"properties": {"resource_type": {"const": "WORK_DELEGATION"}}}
      ]
    },
    "dependencyRef": {
      "allOf": [
        {"$ref": "#/$defs/typedRefBase"},
        {"properties": {"resource_type": {"const": "WORK_DEPENDENCY"}}}
      ]
    },
    "resultRef": {
      "allOf": [
        {"$ref": "#/$defs/typedRefBase"},
        {"properties": {"resource_type": {"const": "WORK_RESULT"}}}
      ]
    },
    "transitionRef": {
      "allOf": [
        {"$ref": "#/$defs/typedRefBase"},
        {"properties": {"resource_type": {"const": "WORK_STATE_TRANSITION"}}}
      ]
    },
    "retryIntentRef": {
      "allOf": [
        {"$ref": "#/$defs/typedRefBase"},
        {"properties": {"resource_type": {"const": "RETRY_INTENT"}}}
      ]
    },
    "escalationIntentRef": {
      "allOf": [
        {"$ref": "#/$defs/typedRefBase"},
        {"properties": {"resource_type": {"const": "ESCALATION_INTENT"}}}
      ]
    },
    "workTarget": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "target_type": {"const": "PRINCIPAL"},
            "principal": {"$ref": "https://leosai.org/contracts/trust-common.v1.schema.json#/$defs/principalRef"}
          },
          "required": ["target_type", "principal"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "target_type": {"const": "EMPLOYEE"},
            "resource": {"$ref": "https://leosai.org/contracts/organization-common.v1.schema.json#/$defs/employeeRef"}
          },
          "required": ["target_type", "resource"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "target_type": {"const": "TEAM"},
            "resource": {"$ref": "https://leosai.org/contracts/organization-common.v1.schema.json#/$defs/teamRef"}
          },
          "required": ["target_type", "resource"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "target_type": {"const": "POSITION"},
            "resource": {"$ref": "https://leosai.org/contracts/organization-common.v1.schema.json#/$defs/positionRef"}
          },
          "required": ["target_type", "resource"]
        }
      ]
    },
    "recordMode": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {"kind": {"const": "CANONICAL_TARGET"}},
          "required": ["kind"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {"const": "DEVELOPMENT_FIXTURE"},
            "authoritative": {"const": false},
            "production_eligible": {"const": false}
          },
          "required": ["kind", "authoritative", "production_eligible"]
        }
      ]
    },
    "stateEvidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "transition_authority": {"$ref": "https://leosai.org/contracts/trust-common.v1.schema.json#/$defs/authorityRef"},
        "actor_context_ref": {
          "allOf": [
            {"$ref": "https://leosai.org/contracts/trust-common.v1.schema.json#/$defs/revisionedResourceRef"},
            {"properties": {"resource_type": {"const": "ACTOR_CONTEXT"}}}
          ]
        },
        "authorization_decision_ref": {"$ref": "https://leosai.org/contracts/organization-common.v1.schema.json#/$defs/authorizationDecisionRef"},
        "approval_verification_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "https://leosai.org/contracts/organization-common.v1.schema.json#/$defs/approvalVerificationRef"}
        },
        "event_ref": {"$ref": "https://leosai.org/contracts/organization-common.v1.schema.json#/$defs/eventRef"},
        "transitioned_at": {"type": "string", "format": "date-time"}
      },
      "required": [
        "transition_authority",
        "actor_context_ref",
        "authorization_decision_ref",
        "approval_verification_refs",
        "event_ref",
        "transitioned_at"
      ]
    },
    "effectivePeriod": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "effective_from": {"type": "string", "format": "date-time"},
        "effective_until": {"type": "string", "format": "date-time"}
      },
      "required": ["effective_from"]
    },
    "dueWindow": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "not_before": {"type": "string", "format": "date-time"},
        "due_at": {"type": "string", "format": "date-time"}
      }
    },
    "governanceRequirements": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "approval_required": {"type": "boolean"},
        "approval_policy_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "https://leosai.org/contracts/trust-common.v1.schema.json#/$defs/evidenceRef"}
        },
        "verification_required": {"type": "boolean"},
        "verification_criteria_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "https://leosai.org/contracts/trust-common.v1.schema.json#/$defs/evidenceRef"}
        },
        "required_evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "https://leosai.org/contracts/trust-common.v1.schema.json#/$defs/evidenceRef"}
        }
      },
      "required": [
        "approval_required",
        "approval_policy_refs",
        "verification_required",
        "verification_criteria_refs",
        "required_evidence_refs"
      ]
    },
    "outputExpectation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "output_id": {"$ref": "https://leosai.org/contracts/trust-common.v1.schema.json#/$defs/identifier"},
        "description": {"type": "string", "minLength": 1, "maxLength": 2048},
        "required": {"type": "boolean"},
        "contract_ref": {"$ref": "https://leosai.org/contracts/capability-plugin-common.v1.schema.json#/$defs/contractReference"}
      },
      "required": ["output_id", "description", "required"]
    },
    "artifactLink": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "artifact_ref": {"$ref": "https://leosai.org/contracts/capability-plugin-common.v1.schema.json#/$defs/artifactRef"},
        "organization_ref": {"$ref": "https://leosai.org/contracts/organization-common.v1.schema.json#/$defs/organizationRef"},
        "output_id": {"$ref": "https://leosai.org/contracts/trust-common.v1.schema.json#/$defs/identifier"},
        "producer_ref": {"$ref": "https://leosai.org/contracts/trust-common.v1.schema.json#/$defs/principalRef"},
        "provenance_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "https://leosai.org/contracts/trust-common.v1.schema.json#/$defs/evidenceRef"}
        }
      },
      "required": [
        "artifact_ref",
        "organization_ref",
        "output_id",
        "producer_ref",
        "provenance_refs"
      ]
    },
    "assignmentConstraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allowed_target_types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["PRINCIPAL", "EMPLOYEE", "TEAM", "POSITION"]}
        },
        "role_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "https://leosai.org/contracts/organization-common.v1.schema.json#/$defs/roleRef"}
        },
        "position_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "https://leosai.org/contracts/organization-common.v1.schema.json#/$defs/positionRef"}
        },
        "exclusive_assignment": {"type": "boolean"},
        "policy_refs": {"$ref": "https://leosai.org/contracts/organization-common.v1.schema.json#/$defs/policyRefs"}
      },
      "required": [
        "allowed_target_types",
        "role_refs",
        "position_refs",
        "exclusive_assignment",
        "policy_refs"
      ]
    },
    "workflowStep": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "step_id": {"$ref": "https://leosai.org/contracts/trust-common.v1.schema.json#/$defs/identifier"},
        "title": {"type": "string", "minLength": 1, "maxLength": 512},
        "objective": {"type": "string", "minLength": 1, "maxLength": 4096},
        "task_template_ref": {"$ref": "https://leosai.org/contracts/trust-common.v1.schema.json#/$defs/evidenceRef"},
        "required_capability_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "https://leosai.org/contracts/capability-plugin-common.v1.schema.json#/$defs/capabilityRef"}
        },
        "expected_outputs": {
          "type": "array",
          "items": {"$ref": "#/$defs/outputExpectation"}
        },
        "governance": {"$ref": "#/$defs/governanceRequirements"},
        "retry_limit": {"type": "integer", "minimum": 0},
        "cancellation_mode": {"enum": ["STOP", "COMPENSATE", "FINISH_CURRENT"]},
        "branch_condition_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "https://leosai.org/contracts/trust-common.v1.schema.json#/$defs/evidenceRef"}
        }
      },
      "required": [
        "step_id",
        "title",
        "objective",
        "required_capability_refs",
        "expected_outputs",
        "governance",
        "retry_limit",
        "cancellation_mode",
        "branch_condition_refs"
      ]
    },
    "workflowStepDependency": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_step_id": {"$ref": "https://leosai.org/contracts/trust-common.v1.schema.json#/$defs/identifier"},
        "depends_on_step_id": {"$ref": "https://leosai.org/contracts/trust-common.v1.schema.json#/$defs/identifier"},
        "relationship": {"enum": ["FINISH_TO_START", "START_TO_START", "FINISH_TO_FINISH", "BLOCKING", "INFORMATIONAL", "CONDITIONAL"]},
        "join": {"enum": ["NONE", "REQUIRED", "OPTIONAL"]},
        "condition_ref": {"$ref": "https://leosai.org/contracts/trust-common.v1.schema.json#/$defs/evidenceRef"}
      },
      "required": ["source_step_id", "depends_on_step_id", "relationship", "join"]
    },
    "managedDocumentBase": {
      "type": "object",
      "properties": {
        "identity": {"$ref": "https://leosai.org/contracts/trust-common.v1.schema.json#/$defs/managedIdentity"},
        "record_mode": {"$ref": "#/$defs/recordMode"},
        "organization_ref": {"$ref": "https://leosai.org/contracts/organization-common.v1.schema.json#/$defs/organizationRef"},
        "state_evidence": {"$ref": "#/$defs/stateEvidence"}
      },
      "required": ["identity", "record_mode", "organization_ref", "state_evidence"]
    },
    "workRequestDocument": {
      "allOf": [
        {"$ref": "#/$defs/managedDocumentBase"},
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "identity": {"$ref": "https://leosai.org/contracts/trust-common.v1.schema.json#/$defs/managedIdentity"},
            "record_mode": {"$ref": "#/$defs/recordMode"},
            "organization_ref": {"$ref": "https://leosai.org/contracts/organization-common.v1.schema.json#/$defs/organizationRef"},
            "state_evidence": {"$ref": "#/$defs/stateEvidence"},
            "contract_version": {"const": "leos.work-request.v1"},
            "requesting_principal": {"$ref": "https://leosai.org/contracts/trust-common.v1.schema.json#/$defs/principalRef"},
            "submitting_principal": {"$ref": "https://leosai.org/contracts/trust-common.v1.schema.json#/$defs/principalRef"},
            "title": {"type": "string", "minLength": 1, "maxLength": 512},
            "description": {"type": "string", "minLength": 1, "maxLength": 8192},
            "desired_outcome": {"type": "string", "minLength": 1, "maxLength": 8192},
            "requested_deliverables": {"type": "array", "items": {"$ref": "#/$defs/outputExpectation"}},
            "constraints": {"type": "array", "uniqueItems": true, "items": {"$ref": "https://leosai.org/contracts/trust-common.v1.schema.json#/$defs/evidenceRef"}},
            "urgency": {"enum": ["LOW", "NORMAL", "HIGH", "CRITICAL"]},
            "requested_due_window": {"$ref": "#/$defs/dueWindow"},
            "policy_refs": {"$ref": "https://leosai.org/contracts/organization-common.v1.schema.json#/$defs/policyRefs"},
            "required_capability_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "https://leosai.org/contracts/capability-plugin-common.v1.schema.json#/$defs/capabilityRef"}},
            "source_ref": {"$ref": "https://leosai.org/contracts/trust-common.v1.schema.json#/$defs/evidenceRef"},
            "status": {"enum": ["DRAFT", "SUBMITTED", "UNDER_REVIEW", "ACCEPTED", "REJECTED", "WITHDRAWN", "CONVERTED", "CLOSED"]},
            "acceptance_transition_ref": {"$ref": "#/$defs/transitionRef"},
            "conversion_job_ref": {"$ref": "#/$defs/jobRef"}
          },
          "required": [
            "contract_version",
            "requesting_principal",
            "submitting_principal",
            "title",
            "description",
            "desired_outcome",
            "requested_deliverables",
            "constraints",
            "urgency",
            "requested_due_window",
            "policy_refs",
            "required_capability_refs",
            "status"
          ],
          "allOf": [
            {
              "if": {"properties": {"status": {"enum": ["ACCEPTED", "CONVERTED"]}}, "required": ["status"]},
              "then": {"required": ["acceptance_transition_ref"]}
            },
            {
              "if": {"properties": {"status": {"const": "CONVERTED"}}, "required": ["status"]},
              "then": {"required": ["conversion_job_ref"]}
            }
          ]
        }
      ],
      "type": "object"
    },
    "workflowDefinitionDocument": {
      "allOf": [
        {"$ref": "#/$defs/managedDocumentBase"},
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "identity": {"$ref": "https://leosai.org/contracts/trust-common.v1.schema.json#/$defs/managedIdentity"},
            "record_mode": {"$ref": "#/$defs/recordMode"},
            "organization_ref": {"$ref": "https://leosai.org/contracts/organization-common.v1.schema.json#/$defs/organizationRef"},
            "state_evidence": {"$ref": "#/$defs/stateEvidence"},
            "contract_version": {"const": "leos.workflow-definition.v1"},
            "description": {"type": "string", "minLength": 1, "maxLength": 8192},
            "semantic_version": {"$ref": "https://leosai.org/contracts/capability-plugin-common.v1.schema.json#/$defs/semanticVersion"},
            "current_revision_ref": {"$ref": "#/$defs/workflowRevisionRef"},
            "policy_refs": {"$ref": "https://leosai.org/contracts/organization-common.v1.schema.json#/$defs/policyRefs"},
            "status": {"enum": ["DRAFT", "ACTIVE", "DEPRECATED", "RETIRED"]}
          },
          "required": ["contract_version", "description", "semantic_version", "current_revision_ref", "policy_refs", "status"]
        }
      ],
      "type": "object"
    },
    "workflowRevisionDocument": {
      "allOf": [
        {"$ref": "#/$defs/managedDocumentBase"},
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "identity": {"$ref": "https://leosai.org/contracts/trust-common.v1.schema.json#/$defs/managedIdentity"},
            "record_mode": {"$ref": "#/$defs/recordMode"},
            "organization_ref": {"$ref": "https://leosai.org/contracts/organization-common.v1.schema.json#/$defs/organizationRef"},
            "state_evidence": {"$ref": "#/$defs/stateEvidence"},
            "contract_version": {"const": "leos.workflow-revision.v1"},
            "workflow_definition_ref": {"$ref": "#/$defs/workflowDefinitionRef"},
            "semantic_version": {"$ref": "https://leosai.org/contracts/capability-plugin-common.v1.schema.json#/$defs/semanticVersion"},
            "immutable": {"const": true},
            "parameters_contract_ref": {"$ref": "https://leosai.org/contracts/capability-plugin-common.v1.schema.json#/$defs/contractReference"},
            "steps": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/workflowStep"}},
            "dependencies": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/workflowStepDependency"}},
            "entry_criteria_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "https://leosai.org/contracts/trust-common.v1.schema.json#/$defs/evidenceRef"}},
            "completion_criteria_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "https://leosai.org/contracts/trust-common.v1.schema.json#/$defs/evidenceRef"}},
            "parallelism": {"enum": ["SEQUENTIAL", "DECLARED_DAG"]},
            "compensation_policy_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "https://leosai.org/contracts/trust-common.v1.schema.json#/$defs/evidenceRef"}},
            "status": {"enum": ["DRAFT", "PUBLISHED", "SUPERSEDED", "REVOKED"]}
          },
          "required": [
            "contract_version",
            "workflow_definition_ref",
            "semantic_version",
            "immutable",
            "parameters_contract_ref",
            "steps",
            "dependencies",
            "entry_criteria_refs",
            "completion_criteria_refs",
            "parallelism",
            "compensation_policy_refs",
            "status"
          ]
        }
      ],
      "type": "object"
    },
    "jobDefinitionDocument": {
      "allOf": [
        {"$ref": "#/$defs/managedDocumentBase"},
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "identity": {"$ref": "https://leosai.org/contracts/trust-common.v1.schema.json#/$defs/managedIdentity"},
            "record_mode": {"$ref": "#/$defs/recordMode"},
            "organization_ref": {"$ref": "https://leosai.org/contracts/organization-common.v1.schema.json#/$defs/organizationRef"},
            "state_evidence": {"$ref": "#/$defs/stateEvidence"},
            "contract_version": {"const": "leos.job-definition.v1"},
            "source_work_request_ref": {"$ref": "#/$defs/workRequestRef"},
            "source_workflow_definition_ref": {"$ref": "#/$defs/workflowDefinitionRef"},
            "source_workflow_revision_ref": {"$ref": "#/$defs/workflowRevisionRef"},
            "title": {"type": "string", "minLength": 1, "maxLength": 512},
            "objective": {"type": "string", "minLength": 1, "maxLength": 8192},
            "responsible_scope": {
              "oneOf": [
                {"$ref": "https://leosai.org/contracts/organization-common.v1.schema.json#/$defs/organizationRef"},
                {"$ref": "https://leosai.org/contracts/organization-common.v1.schema.json#/$defs/departmentRef"},
                {"$ref": "https://leosai.org/contracts/organization-common.v1.schema.json#/$defs/teamRef"}
              ]
            },
            "status": {"enum": ["DRAFT", "READY", "ACTIVE", "BLOCKED", "PAUSED", "COMPLETED", "FAILED", "CANCELLED", "AWAITING_VERIFICATION", "VERIFIED", "CLOSED"]},
            "priority": {"type": "integer", "minimum": 0, "maximum": 100},
            "due_window": {"$ref": "#/$defs/dueWindow"},
            "policy_refs": {"$ref": "https://leosai.org/contracts/organization-common.v1.schema.json#/$defs/policyRefs"},
            "required_capability_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "https://leosai.org/contracts/capability-plugin-common.v1.schema.json#/$defs/capabilityRef"}},
            "expected_outputs": {"type": "array", "items": {"$ref": "#/$defs/outputExpectation"}},
            "governance": {"$ref": "#/$defs/governanceRequirements"},
            "assignment_constraints": {"$ref": "#/$defs/assignmentConstraints"},
            "result_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/resultRef"}},
            "verification_evidence_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "https://leosai.org/contracts/trust-common.v1.schema.json#/$defs/evidenceRef"}},
            "closure_transition_ref": {"$ref": "#/$defs/transitionRef"}
          },
          "required": [
            "contract_version",
            "title",
            "objective",
            "responsible_scope",
            "status",
            "priority",
            "due_window",
            "policy_refs",
            "required_capability_refs",
            "expected_outputs",
            "governance",
            "assignment_constraints",
            "result_refs",
            "verification_evidence_refs"
          ]
        }
      ],
      "type": "object"
    },
    "taskDefinitionDocument": {
      "allOf": [
        {"$ref": "#/$defs/managedDocumentBase"},
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "identity": {"$ref": "https://leosai.org/contracts/trust-common.v1.schema.json#/$defs/managedIdentity"},
            "record_mode": {"$ref": "#/$defs/recordMode"},
            "organization_ref": {"$ref": "https://leosai.org/contracts/organization-common.v1.schema.json#/$defs/organizationRef"},
            "state_evidence": {"$ref": "#/$defs/stateEvidence"},
            "contract_version": {"const": "leos.task-definition.v1"},
            "parent_job_ref": {"$ref": "#/$defs/jobRef"},
            "source_workflow_revision_ref": {"$ref": "#/$defs/workflowRevisionRef"},
            "source_workflow_step_id": {"$ref": "https://leosai.org/contracts/trust-common.v1.schema.json#/$defs/identifier"},
            "title": {"type": "string", "minLength": 1, "maxLength": 512},
