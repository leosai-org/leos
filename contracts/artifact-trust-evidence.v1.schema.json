{
  "$id": "https://leosai.org/contracts/artifact-trust-evidence.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LEOS Artifact Trust Evidence v1",
  "description": "Digest, publisher, signer, provenance, policy, verification, and revocation evidence. Trust evidence never publishes, installs, or activates an artifact.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "leos.artifact-trust-evidence.v1"
    },
    "identity": {
      "$ref": "https://leosai.org/contracts/trust-common.v1.schema.json#/$defs/managedIdentity"
    },
    "artifact_ref": {
      "$ref": "https://leosai.org/contracts/trust-common.v1.schema.json#/$defs/revisionedResourceRef"
    },
    "artifact_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "content_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "publisher": {
      "$ref": "https://leosai.org/contracts/trust-common.v1.schema.json#/$defs/principalRef"
    },
    "signatures": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "signer": {
            "$ref": "https://leosai.org/contracts/trust-common.v1.schema.json#/$defs/principalRef"
          },
          "algorithm": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "key_ref": {
            "$ref": "https://leosai.org/contracts/trust-common.v1.schema.json#/$defs/identifier"
          },
          "signature_ref": {
            "$ref": "https://leosai.org/contracts/trust-common.v1.schema.json#/$defs/identifier"
          }
        },
        "required": [
          "signer",
          "algorithm",
          "key_ref",
          "signature_ref"
        ]
      }
    },
    "provenance_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "https://leosai.org/contracts/trust-common.v1.schema.json#/$defs/evidenceRef"
      }
    },
    "trust_policy_ref": {
      "$ref": "https://leosai.org/contracts/trust-common.v1.schema.json#/$defs/evidenceRef"
    },
    "verifier": {
      "$ref": "https://leosai.org/contracts/trust-common.v1.schema.json#/$defs/authorityRef"
    },
    "outcome": {
      "enum": [
        "TRUSTED",
        "UNTRUSTED",
        "REVOKED",
        "INDETERMINATE"
      ]
    },
    "reasons": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    },
    "revocation_ref": {
      "$ref": "https://leosai.org/contracts/trust-common.v1.schema.json#/$defs/evidenceRef"
    },
    "verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "valid_until": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "contract_version",
    "identity",
    "artifact_ref",
    "artifact_version",
    "content_digest",
    "publisher",
    "signatures",
    "provenance_refs",
    "trust_policy_ref",
    "verifier",
    "outcome",
    "reasons",
    "verified_at",
    "valid_until"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "TRUSTED"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "properties": {
          "signatures": {
            "minItems": 1
          }
        }
      },
      "else": {
        "properties": {
          "reasons": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "REVOKED"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "required": [
          "revocation_ref"
        ]
      },
      "else": {
        "not": {
          "required": [
            "revocation_ref"
          ]
        }
      }
    }
  ]
}
