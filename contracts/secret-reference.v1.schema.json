{
  "$id": "https://leosai.org/contracts/secret-reference.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LEOS Secret Reference v1",
  "description": "Opaque Secret Authority identity and lifecycle evidence. This contract never carries secret values and possession never authorizes resolution.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "leos.secret-reference.v1"
    },
    "identity": {
      "$ref": "https://leosai.org/contracts/trust-common.v1.schema.json#/$defs/managedIdentity"
    },
    "secret_authority": {
      "$ref": "https://leosai.org/contracts/trust-common.v1.schema.json#/$defs/authorityRef"
    },
    "backend_ref": {
      "$ref": "https://leosai.org/contracts/trust-common.v1.schema.json#/$defs/identifier"
    },
    "version_ref": {
      "$ref": "https://leosai.org/contracts/trust-common.v1.schema.json#/$defs/identifier"
    },
    "secret_class": {
      "enum": [
        "PROVIDER_CREDENTIAL",
        "TOOL_CREDENTIAL",
        "SIGNING_KEY",
        "SERVICE_CREDENTIAL",
        "USER_PROTECTED_VALUE"
      ]
    },
    "status": {
      "enum": [
        "ACTIVE",
        "ROTATING",
        "REVOKED",
        "DELETED"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "rotated_at": {
      "type": "string",
      "format": "date-time"
    },
    "revoked_at": {
      "type": "string",
      "format": "date-time"
    },
    "deleted_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "contract_version",
    "identity",
    "secret_authority",
    "backend_ref",
    "version_ref",
    "secret_class",
    "status",
    "created_at"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "ROTATING"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "rotated_at"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "REVOKED"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "revoked_at"
        ]
      },
      "else": {
        "not": {
          "required": [
            "revoked_at"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "DELETED"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "deleted_at"
        ]
      },
      "else": {
        "not": {
          "required": [
            "deleted_at"
          ]
        }
      }
    }
  ]
}
